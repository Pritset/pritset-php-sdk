{
    "name": "pritset/pritset-php",
    "description": "Official PHP SDK for the Pritset Document API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pritset", "pdf", "documents", "templates", "sdk"],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pritset\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pritset\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "contract:check": "php scripts/verify-contract.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "verify": [
            "@contract:check",
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
