PRITSET_BASE_URL=https://api.pritset.com
PRITSET_ACCESS_TOKEN=replace-me
PRITSET_SECRET=replace-me
PRITSET_WEBHOOK_URL=https://your-controlled-test-receiver.example.com/pritset
# Allows the asynchronous webhook job to start before its temporary template is deleted.
PRITSET_WEBHOOK_SETTLE_SECONDS=10
# Both flags must be explicitly enabled for a production test user.
PRITSET_ALLOW_PRODUCTION=false
PRITSET_PRODUCTION_TEST_USER_CONFIRMED=false
# Lowercase letters, digits, and dashes only; used in temporary template names and tags.
PRITSET_TEST_RUN_PREFIX=pritset-php-production-test
# Optional; defaults to tests/fixtures/staging-template.docx
# PRITSET_TEMPLATE_PATH=C:\path\to\template.docx
# Optional; the PowerShell launcher also detects configured PHP and Git for Windows CA bundles.
# PRITSET_CA_BUNDLE_PATH=C:\path\to\cacert.pem
